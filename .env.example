# Mux Backend environment configuration (example)
# Copy to .env and fill in real values. Never commit real secrets.

# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:pass@localhost:5432/mux

# --- Stellar / Soroban ---
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# --- Mainnet payment feature flag (#881) ---
# Fail-closed kill-switch for the mainnet payment money-path.
# Default is OFF: mainnet payments are DENIED unless explicitly enabled.
# Testnet behavior is unaffected by this flag.
# Set to "true" only after the mainnet readiness checklist is complete.
MAINNET_PAYMENTS_ENABLED=false

# --- Auth / API keys ---
# JWT_SECRET=replace-with-strong-random-secret
# API_KEY_PEPPER=replace-with-strong-random-pepper
